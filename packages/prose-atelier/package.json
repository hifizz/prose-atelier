{
  "name": "prose-atelier",
  "version": "0.1.1",
  "description": "MDX-driven long-form content atelier — framework-agnostic core + Next.js renderer. Multiple themes (editorial / notebook / chat, more to come), Shiki code blocks, Mermaid, left-rail TOC.",
  "author": "zilin <276161014@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hifizz/prose-atelier.git",
    "directory": "packages/prose-atelier"
  },
  "homepage": "https://github.com/hifizz/prose-atelier#readme",
  "bugs": {
    "url": "https://github.com/hifizz/prose-atelier/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./styles.css": "./dist/styles.css",
    "./rehype-shiki": "./dist/rehype-shiki.mjs",
    "./rehype-custom-blocks": "./dist/rehype-custom-blocks.mjs",
    "./rehype-add-copy-content": "./dist/rehype-add-copy-content.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:js": "bunchee",
    "build:css": "node scripts/build-css.mjs",
    "build:rehype": "node scripts/copy-rehype.mjs",
    "build": "pnpm run build:js && pnpm run build:css && pnpm run build:rehype",
    "dev": "bunchee --watch",
    "prepublishOnly": "pnpm run build",
    "verify": "node scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "shiki": "^4.0.2",
    "next-mdx-remote": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rehype-slug": "^6.0.0",
    "unist-util-visit": "^5.1.0",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bunchee": "^6.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5"
  },
  "keywords": [
    "mdx",
    "prose",
    "typography",
    "longform",
    "themes",
    "article",
    "blog",
    "shiki",
    "mermaid",
    "rehype",
    "react",
    "nextjs"
  ]
}
