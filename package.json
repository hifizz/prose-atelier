{
  "name": "prose-atelier-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: the prose-atelier npm package + the article-template demo app.",
  "scripts": {
    "build": "pnpm --filter prose-atelier build",
    "dev:pkg": "pnpm --filter prose-atelier dev",
    "dev": "pnpm --filter article-template dev",
    "lint": "pnpm -r --parallel lint",
    "pack:pkg": "pnpm --filter prose-atelier pack",
    "publish:pkg": "pnpm --filter prose-atelier publish --access public"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
